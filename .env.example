# Password for the host screen (/host) and the question editor (/admin).
# CHANGE THIS before the wedding.
HOST_PASSWORD=changeme

# Port. Render/Railway set this automatically - leave it alone in production.
PORT=3000

# Optional: hard cap on players (default 300).
MAX_PLAYERS=300

# Pre-set questions: read only from questions.seed.json, make /admin read-only,
# and depend on no disk at all. Recommended =1 in production.
LOCK_QUESTIONS=1
